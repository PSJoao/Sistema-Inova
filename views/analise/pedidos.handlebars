{{!-- views/analise/pedidos.handlebars --}}
<link rel="stylesheet" href="/public/styles/estoque.css">
<link rel="stylesheet" href="/public/styles/catalog-group.css">
<link rel="stylesheet" href="/public/styles/analise-compras.css">
<link rel="stylesheet" href="/public/styles/pedidos-compras.css">

<div class="content-card">
    {{!-- Cabeçalho da Página no Padrão Inova --}}
    <div class="page-header-actions">
        <h1 class="page-title">{{title}}</h1>

        <div style="display: flex; justify-content: end; gap: 10px; flex-wrap: wrap; align-items: center;">
            {{!-- Ações no Modo Normal --}}
            <div id="pedidosNormalActions" style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                <a href="/analise-compras/pesos" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-weight-hanging me-2"></i>Controle de Pesos
                </a>
                <a href="/analise-compras" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-chart-pie me-2"></i>Análise de Compras
                </a>
                <button id="btnMontarRomaneio" class="btn btn-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-truck-loading me-2"></i>Montar Romaneio
                </button>
            </div>

            {{!-- Ações no Modo Montagem de Romaneio --}}
            <div id="romaneioModeActions" style="display: none; gap: 10px; flex-wrap: wrap; align-items: center;">
                <div class="order-mode-badge" id="romaneioModeBadge"
                    style="background: rgba(240, 124, 0, 0.15); border: 1px solid var(--accent-orange, #f07c00);">
                    Romaneio: <strong id="romaneioSelectedCount" style="color: #fff; margin-left: 4px;">0 selecionados
                        (0 peças)</strong>
                </div>
                <button id="btnFinalizarRomaneio" class="btn btn-accent"
                    style="display: inline-flex; align-items: center;" disabled>
                    <i class="fas fa-file-pdf me-2"></i>Finalizar Romaneio
                </button>
                <button id="btnCancelarRomaneio" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
            </div>
        </div>
    </div>

    {{!-- Barra de Filtros no Padrão do Sistema (estoque-filters-bar) --}}
    <div class="estoque-filters-bar">
        {{!-- Busca Rápida --}}
        <div class="estoque-filter-group" style="flex-grow: 1; min-width: 300px;">
            <label for="buscaPedidosInput">Busca Rápida</label>
            <input type="text" id="buscaPedidosInput" class="form-control"
                placeholder="Digite fábrica, número do pedido, SKU ou produto...">
        </div>

        {{!-- Filtro por Status (Select igual ao de ordenação) --}}
        <div class="estoque-filter-group" style="min-width: 170px;">
            <label for="selectStatusPedidos">Status</label>
            <select id="selectStatusPedidos" class="form-control">
                <option value="pendente" selected>Pendentes</option>
                <option value="finalizado">Finalizados</option>
                <option value="todos">Todos</option>
            </select>
        </div>

        {{!-- Ordenação --}}
        <div class="estoque-filter-group" style="min-width: 170px;">
            <label for="selectOrdenacaoPedidos">Ordenar por</label>
            <select id="selectOrdenacaoPedidos" class="form-control">
                <option value="recentes" selected>Mais Recentes</option>
                <option value="antigos">Mais Antigos</option>
                <option value="maior_qtd">Maior Qtd Peças</option>
                <option value="fabrica">Fábrica (A-Z)</option>
            </select>
        </div>
    </div>

    {{!-- Grid de Cards de Pedidos --}}
    <div id="pedidosCardsContainer" class="pedidos-cards-grid">
        {{!-- Inserido dinamicamente pelo JS --}}
    </div>

    {{!-- Estado Vazio --}}
    <div id="pedidosEmptyState" class="pedidos-empty-state" style="display: none;">
        <i class="fas fa-clipboard-check empty-icon"></i>
        <h3>Nenhum pedido encontrado</h3>
        <p id="emptyStateDesc">Não há pedidos cadastrados neste filtro no momento.</p>
        <div style="margin-top: 14px;">
            <a href="/analise-compras" class="btn btn-accent">
                <i class="fas fa-shopping-cart me-2"></i>Ir para Análise e Criar Pedido
            </a>
        </div>
    </div>
</div>

{{!-- Modal de Edição de Pedido --}}
<div id="modalEditarPedido" class="modal-custom-overlay" style="display: none;">
    <div class="modal-custom-container" style="max-width: 820px;">
        <div class="modal-custom-header">
            <div>
                <h2 class="modal-custom-title">
                    Editar Pedido <span id="modalEditNumeroPedido"
                        style="color: var(--accent-orange, #f07c00); margin-left: 6px;"></span>
                </h2>
                <span id="modalEditFabricaNome" class="modal-subtitle-fabrica"></span>
            </div>
            <button type="button" class="modal-close-btn" id="btnFecharModalEdit">&times;</button>
        </div>

        <div class="modal-custom-body">
            {{!-- Resumo no Topo do Modal --}}
            <div class="modal-summary-bar">
                <span>Produtos no Pedido: <strong id="modalEditTotalItens" style="color: #fff;">0</strong></span>
                <span>Total de Peças: <strong id="modalEditTotalUnidades"
                        style="color: var(--accent-orange, #f07c00);">0 un</strong></span>
            </div>

            {{!-- SEÇÃO 1: ITENS ATUAIS NO PEDIDO --}}
            <div class="modal-section-title">
                Itens no Pedido:
            </div>
            <div class="table-responsive modal-table-box mb-3" style="max-height: 200px;">
                <table class="table modal-items-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">SKU</th>
                            <th>Produto</th>
                            <th style="width: 110px;" class="text-center">Qtd Pedida</th>
                            <th style="width: 50px;" class="text-center">Remover</th>
                        </tr>
                    </thead>
                    <tbody id="modalEditItemsTableBody">
                        {{!-- JS --}}
                    </tbody>
                </table>
            </div>

            {{!-- SEÇÃO 2: OUTROS PRODUTOS DO FORNECEDOR (DISPONÍVEIS PARA ADICIONAR) --}}
            <div class="modal-disponiveis-header">
                <div class="modal-section-title" style="margin-bottom: 0;">
                    Outros Produtos do Fornecedor:
                </div>
                <input type="text" id="modalBuscaDisponiveis" class="form-control form-control-sm"
                    placeholder="Filtrar produtos do fornecedor..." style="max-width: 240px;">
            </div>
            <div class="table-responsive modal-table-box mb-3" style="max-height: 220px;">
                <table class="table modal-items-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">SKU</th>
                            <th>Produto</th>
                            <th style="width: 100px;" class="text-center">Qtd</th>
                            <th style="width: 90px;" class="text-center">Ação</th>
                        </tr>
                    </thead>
                    <tbody id="modalDisponiveisTableBody">
                        {{!-- JS --}}
                    </tbody>
                </table>
            </div>

            {{!-- Observações --}}
            <div style="margin-top: 8px;">
                <label for="modalEditObservacoes"
                    style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px; display: block;">Observações:</label>
                <textarea id="modalEditObservacoes" class="form-control form-control-sm" rows="2"
                    placeholder="Observações do pedido..."></textarea>
            </div>
        </div>

        <div class="modal-custom-footer">
            <button type="button" class="btn btn-secondary" id="btnCancelarModalEdit">Cancelar</button>
            <button type="button" class="btn btn-accent" id="btnSalvarModalEdit">
                Salvar Alterações
            </button>
        </div>
    </div>
</div>

<script src="/public/scripts/pedidosComprasManager.js"></script>