{{!--
views/analise/lista-compras.handlebars
Listagem de análise de compras com busca, paginação, upload de arquivos e tabelas detalhadas.
--}}
<link rel="stylesheet" href="/public/styles/estoque.css">
<link rel="stylesheet" href="/public/styles/catalog-group.css">

<style>
    /* Estilos Adicionais para Análise de Compras */
    #tabela-analise-compras thead th {
        background-color: var(--bg-tertiary) !important;
        color: var(--text-primary) !important;
        border: none !important;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
        vertical-align: middle;
    }
    
    .table-group-header {
        background-color: rgba(240, 124, 0, 0.1) !important;
        color: var(--accent-orange, #f07c00) !important;
        font-weight: bold;
        border-bottom: 2px solid rgba(240, 124, 0, 0.3) !important;
    }

    .input-chegando {
        width: 80px;
        background-color: var(--bg-secondary);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        border-radius: 4px;
        padding: 4px 8px;
        text-align: center;
        transition: border-color 0.2s;
    }

    .input-chegando:focus {
        border-color: var(--accent-orange, #f07c00);
        outline: none;
    }

    .col-venda-real {
        background-color: rgba(255, 255, 255, 0.02);
    }

    .col-venda-estimada {
        background-color: rgba(0, 150, 255, 0.04);
    }
    
    .col-destaque {
        font-weight: bold;
        color: var(--accent-orange, #f07c00);
    }

    .sugestao-positiva {
        color: #4caf50;
        font-weight: bold;
    }

    .sugestao-negativa {
        color: #f44336;
    }
</style>

<div class="content-card">
    {{!-- Cabeçalho da Página --}}
    <div class="page-header-actions">
        <h1 class="page-title">{{title}}</h1>
        <div style="display: flex; justify-content: end; gap: 10px; align-items: center;">
            
            <div class="input-group" style="width: auto;">
                <span class="input-group-text" style="background: var(--bg-tertiary); border: 1px solid rgba(255,255,255,0.1); color: #ccc;">Dias de Estoque</span>
                <input type="number" id="inputDiasEstoque" class="form-control" style="max-width: 80px; text-align: center;" placeholder="Ex: 15" min="1">
            </div>

            <button id="btnImportarVendas" class="btn btn-outline-accent">
                <i class="fas fa-file-excel me-2"></i>Importar Vendas
            </button>
            <button id="btnGeracaoPedidos" class="btn btn-accent">
                <i class="fas fa-shopping-cart me-2"></i>Geração de Pedidos
            </button>
        </div>
    </div>

    {{!-- Barra de Filtros --}}
    <div class="estoque-filters-bar">
        <div class="estoque-filter-group" style="flex-grow: 1; min-width: 320px;">
            <label for="buscaGeral">Busca Rápida</label>
            <div class="search-input-group">
                <input type="text" id="buscaGeral" class="form-control" placeholder="Busque por produto, SKU...">
            </div>
        </div>
        
        <div class="estoque-filter-group">
            <label for="filtroForncedor">Fábrica / Fornecedor</label>
            <select id="filtroForncedor" class="form-control" style="min-width: 200px;">
                <option value="">Todos os Fornecedores</option>
                {{#each fornecedores}}
                    <option value="{{this.bling_id}}">{{this.nome}}</option>
                {{/each}}
            </select>
        </div>
        
        <div class="estoque-filter-group">
            <label for="filtroLimite">Mostrar</label>
            <select id="filtroLimite" class="form-control" style="min-width: 80px;">
                <option value="20">20</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="200">200</option>
                <option value="500">500</option>
            </select>
        </div>
    </div>

    {{!-- Container da Tabela --}}
    <div class="table-responsive mt-3" style="max-height: calc(100vh - 180px); overflow: auto;">
        <table class="table" id="tabela-analise-compras" style="width: max-content; min-width: 100%; table-layout: fixed;">
            <thead style="position: sticky; top: 0; z-index: 10; box-shadow: 0 4px 6px rgba(0,0,0,0.2);">
                <tr>
                    <th rowspan="2" style="width: 250px;">Produto (Pai)</th>
                    <th rowspan="2" class="text-center" style="width: 100px;">Estoque</th>
                    <th rowspan="2" class="text-center" style="width: 120px;">Chegando</th>
                    
                    <th colspan="4" class="text-center table-group-header">Venda Real (Dias)</th>
                    <th colspan="3" class="text-center table-group-header col-venda-estimada">Venda Estimada (30d) baseada em:</th>
                    
                    <th rowspan="2" class="text-center" style="width: 100px;">Média<br>Mensal</th>
                    <th rowspan="2" class="text-center col-destaque" style="width: 100px;">Sugestão</th>
                    <th rowspan="2" class="text-center" style="width: 100px;">Tempo<br>Est. (Dias)</th>
                </tr>
                <tr>
                    <th class="text-center col-venda-real" style="width: 70px;">3</th>
                    <th class="text-center col-venda-real" style="width: 70px;">7</th>
                    <th class="text-center col-venda-real" style="width: 70px;">15</th>
                    <th class="text-center col-venda-real" style="width: 70px;">30</th>
                    
                    <th class="text-center col-venda-estimada" style="width: 80px;">3d</th>
                    <th class="text-center col-venda-estimada" style="width: 80px;">7d</th>
                    <th class="text-center col-venda-estimada" style="width: 80px;">15d</th>
                </tr>
            </thead>
            <tbody id="table-body">
                <tr>
                    <td colspan="13" class="text-center py-4">
                        <div class="modal-spinner" style="display: inline-block;"></div> Carregando dados...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    {{!-- Paginação --}}
    <div id="pagination-container" class="estoque-pagination"></div>
</div>

{{!-- Modal de Importação de Vendas --}}
<div id="modalVendasOverlay" class="modal-overlay" style="display: none;"></div>
<div id="modalVendas" class="custom-modal" style="display: none; max-width: 600px; z-index: 10000;">
    <div class="custom-modal-header">
        <h3 class="custom-modal-title-text">Importar Relatórios de Venda (Excel)</h3>
        <button type="button" class="btn-close btn-close-white fechar-modal-vendas" aria-label="Close" style="background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer;"><i class="fas fa-times"></i></button>
    </div>
    <div class="custom-modal-body">
        <p style="font-size: 0.9rem; color: #ccc; margin-bottom: 15px; line-height: 1.4;">
            É obrigatório o upload <strong>simultâneo</strong> de 4 arquivos extraídos do sistema, contendo as vendas dos últimos 3, 7, 15 e 30 dias.<br />
            <span style="color: #f07c00; font-size: 0.85rem; font-weight: bold;">Coluna A: SKU (Componente) | Coluna F: Quantidade de Saídas</span>
        </p>
        
        <form id="formUploadVendas" enctype="multipart/form-data">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 0.85rem;">Arquivo 3 Dias</label>
                    <input class="form-control form-control-sm input-venda-file" type="file" accept=".xlsx,.xls,.csv" data-periodo="3" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 0.85rem;">Arquivo 7 Dias</label>
                    <input class="form-control form-control-sm input-venda-file" type="file" accept=".xlsx,.xls,.csv" data-periodo="7" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 0.85rem;">Arquivo 15 Dias</label>
                    <input class="form-control form-control-sm input-venda-file" type="file" accept=".xlsx,.xls,.csv" data-periodo="15" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 0.85rem;">Arquivo 30 Dias</label>
                    <input class="form-control form-control-sm input-venda-file" type="file" accept=".xlsx,.xls,.csv" data-periodo="30" required>
                </div>
            </div>
            
            <div id="importVendasSpinner" class="modal-spinner" style="display: none; margin: 15px auto;"></div>
            <div id="importVendasStatusMsg" style="margin-top: 12px; font-size: 0.85rem; text-align: center; display: none;"></div>
        </form>
    </div>
    <div class="custom-modal-footer">
        <button id="btnConfirmarUpload" class="btn btn-accent">Processar Arquivos</button>
        <button class="btn btn-outline-accent fechar-modal-vendas">Cancelar</button>
    </div>
</div>

{{!-- Modal Geração de Pedidos --}}
<div id="modalPedidosOverlay" class="modal-overlay" style="display: none;"></div>
<div id="modalPedidos" class="custom-modal" style="display: none; max-width: 700px; z-index: 10000;">
    <div class="custom-modal-header">
        <h3 class="custom-modal-title-text">Gerar Pedido de Compra</h3>
        <button type="button" class="btn-close fechar-modal-pedidos" aria-label="Close" style="background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer;"><i class="fas fa-times"></i></button>
    </div>
    <div class="custom-modal-body">
        <div class="mb-3">
            <label for="modalFiltroFornecedor" class="form-label">Selecione a Fábrica / Fornecedor</label>
            <select id="modalFiltroFornecedor" class="form-control">
                <option value="">Selecione...</option>
                {{#each fornecedores}}
                    <option value="{{this.bling_id}}">{{this.nome}}</option>
                {{/each}}
            </select>
        </div>
        
        <div id="areaListaProdutosPedido" style="display: none;">
            <p style="font-size: 0.85rem; color: #ccc;">Selecione os produtos para incluir no pedido (As quantidades sugeridas virão preenchidas automaticamente):</p>
            <div style="max-height: 300px; overflow-y: auto; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 10px;">
                <table class="table table-sm table-borderless text-light" style="margin: 0;">
                    <thead>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                            <th style="width: 40px;"><input type="checkbox" id="checkAllPedidos"></th>
                            <th>Produto</th>
                            <th class="text-center" style="width: 100px;">Qtd (Sugestão)</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyProdutosPedido">
                        <!-- Itens renderizados via JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="custom-modal-footer">
        <button id="btnGerarPdfPedido" class="btn btn-accent" disabled>Gerar PDF do Pedido</button>
        <button class="btn btn-outline-accent fechar-modal-pedidos">Cancelar</button>
    </div>
</div>

{{#section "scripts"}}
<script src="/public/scripts/analiseComprasManager.js"></script>
{{/section}}
