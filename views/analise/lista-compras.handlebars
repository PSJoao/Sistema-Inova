{{!--
views/analise/lista-compras.handlebars
Listagem de análise de compras com busca avançada, filtros, ordenação e paginação no padrão Inova.
--}}
<link rel="stylesheet" href="/public/styles/estoque.css">
<link rel="stylesheet" href="/public/styles/catalog-group.css">
<link rel="stylesheet" href="/public/styles/analise-compras.css">

<div class="content-card">
    {{!-- Cabeçalho da Página --}}
    <div class="page-header-actions">
        <h1 class="page-title">{{title}}</h1>

        <div style="display: flex; justify-content: end; gap: 10px; flex-wrap: wrap; align-items: center;">
            {{!-- Widget Dias de Estoque (Sempre Visível) --}}
            <div class="dias-estoque-card"
                title="Informe os dias de estoque desejados para calcular a sugestão de compras">
                <label for="inputDiasEstoque">
                    Dias de Estoque:
                </label>
                <input type="number" id="inputDiasEstoque" class="form-control dias-estoque-input" placeholder="Ex: 15"
                    min="1" step="1">
            </div>

            {{!-- Ações no Modo Normal --}}
            <div id="normalHeaderActions"
                style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                <a href="/analise-compras/pedidos" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-clipboard-list me-2"></i>Controle de Pedidos
                </a>
                <a href="/analise-compras/pesos" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-weight-hanging me-2"></i>Controle de Pesos
                </a>
                <a href="/analise-compras/importar-vendas" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-file-excel me-2"></i>Importar Vendas
                </a>
                <button id="btnGeracaoPedidos" class="btn btn-accent" style="display: inline-flex; align-items: center;">
                    <i class="fas fa-shopping-cart me-2"></i>Gerar Pedidos
                </button>
            </div>

            {{!-- Ações no Modo Configuração de Pedido --}}
            <div id="orderModeActionsBar"
                style="display: none; gap: 10px; flex-wrap: wrap; align-items: center;">
                <div class="order-mode-badge" id="orderModeBadge">
                    Modo Pedido: <strong id="orderModeFabricaNome" style="color: #fff; margin-left: 4px;"></strong>
                </div>
                <button id="btnBaixarPdfPedido" class="btn btn-accent" style="display: inline-flex; align-items: center;">
                    <i class="fas fa-file-pdf me-2"></i><span id="btnBaixarPdfTexto">Baixar PDF do Pedido (0 itens)</span>
                </button>
                <button id="btnSairModoPedido" class="btn btn-outline-accent"
                    style="display: inline-flex; align-items: center;">
                    <i class="fas fa-times me-2"></i>Sair do Modo Pedido
                </button>
            </div>
        </div>
    </div>

    {{!-- Barra de Filtros --}}
    <div class="estoque-filters-bar">
        <div class="estoque-filter-group" style="flex-grow: 1; min-width: 320px;">
            <label for="buscaGeral">Busca Rápida</label>
            <div class="search-input-group">
                <select id="campoBusca" class="search-target-select" title="Selecione o campo de busca">
                    <option value="geral" selected>Geral (Tudo)</option>
                    <option value="sku">SKU da Estrutura</option>
                    <option value="sku_ml">SKU ML</option>
                    <option value="nome">Nome do Produto</option>
                </select>
                <input type="text" id="buscaGeral" class="form-control search-input-with-target"
                    placeholder="Digite SKU ou nome do produto...">
            </div>
        </div>

        {{!-- Filtro Fábrica Pesquisável com Agrupamento Inteligente --}}
        <div class="estoque-filter-group" style="min-width: 240px;">
            <label for="inputFiltroFornecedor">Fábrica / Fornecedor</label>
            <div class="searchable-select-container" id="fornecedorDropdownContainer">
                <input type="text" id="inputFiltroFornecedor" class="form-control searchable-select-input"
                    placeholder="Todas as Fábricas" value="Todas as Fábricas" readonly>
                <input type="hidden" id="filtroFornecedor" value="">
                <i class="fas fa-chevron-down searchable-select-arrow"></i>
                <div class="searchable-select-menu" id="menuFiltroFornecedor" style="display: none;">
                    <div class="searchable-select-search-box">
                        <input type="text" id="buscaMenuFornecedor" class="form-control form-control-sm"
                            placeholder="Pesquisar fábrica...">
                    </div>
                    <div class="searchable-select-options" id="optionsFiltroFornecedor">
                        <div class="searchable-select-option selected" data-value="" data-name="Todas as Fábricas">Todas
                            as Fábricas</div>
                        {{#each fornecedores}}
                        <div class="searchable-select-option" data-value="{{this.chave}}" data-ids="{{this.idsStr}}"
                            data-name="{{this.nome}}" data-aliases="{{this.aliasesStr}}">
                            <span>{{this.nome}}</span>{{#if this.apelidoPrincipal}}<span style="color: var(--accent-orange, #f07c00); font-weight: 600; font-size: 0.78rem; margin-left: 6px; background: rgba(240, 124, 0, 0.12); padding: 1px 6px; border-radius: 4px;">{{this.apelidoPrincipal}}</span>{{/if}}
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <div class="estoque-filter-group">
            <label for="filtroLimite">Mostrar</label>
            <select id="filtroLimite" class="form-control" style="min-width: 80px;">
                <option value="20">20</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </div>
    </div>

    {{!-- Container da Tabela --}}
    <div class="table-responsive mt-3" style="max-height: calc(100vh - 180px); overflow: auto;">
        <table class="table" id="tabela-estoque" style="width: max-content; min-width: 100%; table-layout: fixed;">
            <thead style="position: sticky; top: 0; z-index: 10; box-shadow: 0 4px 6px rgba(0,0,0,0.2);">
                <tr>
                    <th class="sortable text-center" data-column="sku">SKU</th>
                    <th class="sortable text-center" data-column="sku_ml">SKU ML</th>
                    <th class="sortable" data-column="produto_nome">Produto</th>
                    <th class="sortable text-center" data-column="estoque_atual">Estoque</th>
                    <th class="sortable text-center" data-column="estoque_plataforma">Est. Plataforma</th>
                    <th class="sortable text-center" data-column="chegando">Chegando</th>
                    <th class="sortable text-center" data-column="vendas_3d">Venda 3d</th>
                    <th class="sortable text-center" data-column="vendas_7d">Venda 7d</th>
                    <th class="sortable text-center" data-column="vendas_15d">Venda 15d</th>
                    <th class="sortable text-center" data-column="vendas_30d">Venda 30d</th>
                    <th class="sortable text-center" data-column="est_3d">Est. 3d</th>
                    <th class="sortable text-center" data-column="est_7d">Est. 7d</th>
                    <th class="sortable text-center" data-column="est_15d">Est. 15d</th>
                    <th class="sortable text-center" data-column="media_venda">Média Mensal</th>
                    <th class="sortable text-center" data-column="sugestao">Sugestão Compra</th>
                    <th class="sortable text-center" data-column="tempo_est">Duração Estoque</th>
                    <th class="sortable text-center" data-column="tempo_est_plataforma">Duração Est. Plat.</th>
                </tr>
            </thead>
            <tbody id="table-body">
                <tr>
                    <td colspan="16" class="text-center py-4 text-muted">
                        <div class="modal-spinner" style="display: inline-block;"></div> Carregando dados de análise...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    {{!-- Estado Vazio --}}
    <div id="empty-state" class="estoque-empty-state" style="display: none;">
        <i class="fas fa-boxes"></i>
        <p>Nenhum produto encontrado com os filtros aplicados.</p>
        <p style="font-size: 0.85rem;">Tente ajustar a busca ou limpar os filtros.</p>
    </div>

    {{!-- Paginação --}}
    <div id="pagination-container" class="estoque-pagination"></div>
</div>

{{#section "scripts"}}
<script src="/public/scripts/analiseComprasManager.js"></script>
{{/section}}