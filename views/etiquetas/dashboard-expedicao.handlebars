{{#section "head" }}
<link href="/public/styles/dashboardExpedicao.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap4.min.css">
{{/section}}

<div class="dashboard-wrapper">
    <div class="dashboard-header">
        <h1 class="page-title-dark">Painel de Gestão da Expedição</h1>
    </div>

    {{> messages}}

    <div class="dashboard-panel">
        <h4 class="panel-title"><i class="fas fa-chart-pie"></i> Balanço do Dia</h4>
        <div class="stat-grid">
            <div class="stat-card stat-card-clickable" data-filter-status="Checado"
                style="background: rgba(13, 202, 240, 0.06); border-color: rgba(13, 202, 240, 0.25);">
                <div class="stat-value" id="dash-checados" style="color: #0dcaf0;">0</div>
                <h4 style="color: #0dcaf0;">Checados</h4>
            </div>
            <div class="stat-card stat-card-clickable" data-filter-status="Pendente"
                style="background: rgba(255, 152, 0, 0.06); border-color: rgba(255, 152, 0, 0.25);">
                <div class="stat-value" id="dash-pendentes" style="color: #ff9800;">0</div>
                <h4 style="color: #ff9800;">Pendentes</h4>
            </div>
            <div class="stat-card stat-card-clickable" data-filter-status="Pego, Sem Etiquetar"
                style="background: rgba(108, 117, 125, 0.06); border-color: rgba(108, 117, 125, 0.25);">
                <div class="stat-value" id="dash-sem-nota" style="color: #6c757d;">0</div>
                <h4 style="color: #6c757d;">Pego, Sem Etiq.</h4>
            </div>
            <div class="stat-card stat-card-clickable" data-filter-status="Conferência Envio"
                style="background: rgba(111, 66, 193, 0.06); border-color: rgba(111, 66, 193, 0.25);">
                <div class="stat-value" id="dash-conf-envio" style="color: #6f42c1;">0</div>
                <h4 style="color: #6f42c1;">Conf. Envio</h4>
            </div>
            <div class="stat-card subtracoes stat-card-clickable" data-filter-status="Sem Estoque">
                <div class="stat-value" id="dash-subtracoes">0</div>
                <h4>Sem Estoque</h4>
            </div>
            <div class="stat-card destaque stat-card-clickable" data-filter-status="">
                <div class="stat-value" id="dash-total">0</div>
                <h4>A Expedir</h4>
            </div>
            <div class="stat-card success stat-card-clickable" data-filter-status="Expedido">
                <div class="stat-value" id="dash-expedidos">0</div>
                <h4>Expedidos</h4>
            </div>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="table-toolbar">
            <h4 class="panel-title mb-0" style="border: none; padding: 0; white-space: nowrap;"><i
                    class="fas fa-clipboard-list"></i>
                Fila de Expedição</h4>
            <div class="toolbar-actions">
                <div class="toolbar-buttons">
                    <button id="btn-exportar-tabela-full" class="btn-toolbar" title="Gerar Relatório">
                        <i class="fas fa-file-excel"></i><span>Rel. Tabela</span>
                    </button>
                    <button id="btn-exportar-tabela-agrupada" class="btn-toolbar" title="Contagem SKU">
                        <i class="fas fa-boxes"></i><span>Contagem SKU</span>
                    </button>
                    <button id="btn-exportar-tabela-restante" class="btn-toolbar btn-toolbar-outline" title="Faltantes">
                        <i class="fas fa-clipboard-check"></i><span>Rel. Faltantes</span>
                    </button>
                    <button id="btn-imprimir-pendencias" class="btn-toolbar" title="Imprimir Etiquetas">
                        <i class="fas fa-print"></i><span>Imprimir Etiq.</span>
                    </button>
                    <button id="btn-massa-modo" class="btn-toolbar btn-toolbar-outline" title="Seleção em Massa">
                        <i class="fas fa-check-square"></i><span>Seleção em Massa</span>
                    </button>
                </div>
                <div class="toolbar-filters">
                    <div class="filter-group">
                        <label class="filter-label">Interno:</label>
                        <select id="filtro-status-tabela" class="filter-select" title="Filtro de Status">
                            <option value="">Todos</option>
                            <option value="Pendente">Pendentes</option>
                            <option value="Hub">Hub</option>
                            <option value="Checado">Checados</option>
                            <option value="Sem Estoque">Sem Estoque</option>
                            <option value="Cancelado">Cancelados</option>
                            <option value="Cancelado Efetivado">Canc. Efetivados</option>
                            <option value="Expedido">Expedidos</option>
                            <option value="Etiq. Impressa">Etiq. Impressa</option>
                            <option value="Pego, Sem Etiquetar">Pego, Sem Etiq.</option>
                            <option value="Conferência Envio">Conf. Envio</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">ML:</label>
                        <select id="filtro-status-ml-tabela" class="filter-select" title="Filtro Status ML">
                            <option value="">Todos</option>
                            <option value="Pronto para enviar">Pronto p/ enviar</option>
                            <option value="Aguardando">Aguardando</option>
                            <option value="Enviado">Enviado</option>
                            <option value="Entregue">Entregue</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label class="filter-label">Foto:</label>
                        <select id="filtro-status-foto-tabela" class="filter-select" title="Filtro Status Foto">
                            <option value="">Todos</option>
                            <option value="Foto: Pendente">Pendente</option>
                            <option value="Foto: Validado">Validado</option>
                            <option value="Foto: Erro">Erro</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- PAINEL FLUTUANTE DE AÇÃO EM MASSA -->
        <div id="massa-action-panel"
            style="display: none; background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 8px; border: 1px solid var(--accent-orange); margin-bottom: 15px; margin-top: -5px; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 15px;">
                <span style="color: var(--accent-orange); font-weight: bold; font-size: 1.1rem;"
                    id="massa-count-display">0 selecionadas</span>
                <button class="btn btn-sm text-muted" id="btn-massa-clear"
                    style="padding: 0; text-decoration: none; background:transparent; border:none;"><i
                        class="fas fa-times"></i> Desmarcar Todas</button>
                <div class="custom-control custom-checkbox"
                    style="display: flex; align-items: center; gap: 5px; margin-left: 10px;">
                    <input type="checkbox" class="custom-control-input" id="chk-massa-selecao-total"
                        style="cursor: pointer; width: 16px; height: 16px;">
                    <label class="custom-control-label" for="chk-massa-selecao-total"
                        style="color: var(--text-primary); cursor: pointer; margin: 0; font-size: 0.9rem;">Seleção
                        Total</label>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <label style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">Mudar para:</label>
                <select id="massa-acao-status" class="form-control-dark" style="min-width: 150px; font-size: 0.85rem;">
                    <option value="pendente">Pendente</option>
                    <option value="hub">Hub</option>
                    <option value="checado">Checado</option>
                    <option value="impresso">Expedido</option>
                    <option value="sem_estoque">Sem Estoque</option>
                    <option value="cancelamento">Cancelado</option>
                    <option value="cancelado">Cancelado Efetivado</option>
                    <option value="bip_sem_etiq">Pego, Sem Etiquetar</option>
                    <option value="conf_envio">Conferência Envio</option>
                </select>
                <button id="btn-massa-aplicar" class="btn-premium orange"
                    style="padding: 0.4rem 1.2rem; font-size: 0.9rem; border-radius: 6px;">
                    Mudar Status</button>
            </div>
        </div>

        <table class="table" id="tabela-pendencias" style="width: 100%">
            <thead>
                <tr>
                    <th id="th-massa" style="display:none; width: 40px; text-align: center;"><input type="checkbox"
                            id="chk-master-massa" style="cursor: pointer; width: 16px; height: 16px;"></th>
                    <th>Data Entrada</th>
                    <th>Nota Fiscal</th>
                    <th>Pedido</th>
                    <th>Núm. Loja</th>
                    <th>SKU / Produto</th>
                    <th>Estoque</th>
                    <th>Localização</th>
                    <th>Status ML</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    <div class="panel-group" style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <div class="dashboard-panel" style="flex: 1; min-width: 350px;">
            <h4 class="panel-title"><i class="fas fa-users"></i> Gerar Etiquetas de Equipe</h4>
            <p class="description-text mb-3">Insira os dados da equipe para gerar etiquetas em PDF prontas para
                bipagem.</p>

            <form id="form-etiquetas-carregadores">
                <div id="carregadores-container">
                    <!-- Preenchido via JS do banco de dados -->
                </div>

                <div class="btn-actions-group"
                    style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; gap: 10px;">
                    <button type="button" id="btn-add-carregador" class="btn-premium outline">
                        <i class="fas fa-plus"></i> Novo Carregador
                    </button>
                    <button type="submit" id="btn-gerar-zip" class="btn-premium orange">
                        <i class="fas fa-file-archive"></i> Baixar ZIP
                    </button>
                </div>
            </form>
        </div>

        <div class="dashboard-panel" style="flex: 1; min-width: 350px;">
            <h4 class="panel-title"><i class="fas fa-trophy"></i> Produtividade Diária</h4>
            <div class="table-responsive">
                <table class="table" id="tabela-produtividade" style="width: 100%">
                    <thead>
                        <tr>
                            <th>Carregador</th>
                            <th>Kits Separados</th>
                            <th>Itens Unitários</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {{!-- NOVA TABELA: PEDIDOS COM FOTO --}}
    <div class="dashboard-panel mb-4">
        <div class="table-controls"
            style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; gap: 10px;">
            <h4 class="panel-title mb-0" style="border: none; padding: 0;"><i class="fas fa-camera"></i>
                Pedidos com Foto (Conferência)</h4>
        </div>

        <div class="table-responsive">
            <table class="table" id="tabela-pedidos-foto" style="width: 100%">
                <thead>
                    <tr>
                        <th>NFe</th>
                        <th>Núm. Loja</th>
                        <th>Data Conferência</th>
                        <th style="text-align: center;">Etiqueta</th>
                        <th style="text-align: center;">Produto</th>
                        <th>Validação</th>
                        <th style="text-align: center;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>

    {{!-- NOVA TABELA: GESTÃO DE CONFERÊNCIA EM MASSA --}}
    <div class="dashboard-panel mb-4">
        <div class="table-controls"
            style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 1rem; gap: 10px;">
            <h4 class="panel-title mb-0" style="border: none; padding: 0;"><i class="fas fa-tasks"></i>
                Gestão de Conferência (Envio em Lote)</h4>

            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <button id="btn-ver-progresso-lote" class="btn-premium outline"
                    style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 6px;">
                    <i class="fas fa-eye"></i> Ver Status do Envio
                </button>
                <button id="btn-sync-conferencia-bling" class="btn-premium orange"
                    style="padding: 0.4rem 0.8rem; font-size: 0.85rem; border-radius: 6px;">
                    <i class="fas fa-cloud-upload-alt"></i> Enviar Pendentes ao Bling
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table" id="tabela-gestao-conferencia" style="width: 100%">
                <thead>
                    <tr>
                        <th>NFe</th>
                        <th>Pedido</th>
                        <th>Conferente</th>
                        <th>Data Conferência</th>
                        <th>Status Local</th>
                        <th>Status Bling</th>
                        <th>Erro Bling</th>
                        <th style="width: 60px; text-align: center;">Ação</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="panel-group" style="display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
    <div class="dashboard-panel" style="flex: 1; min-width: 350px;">
        <h4 class="panel-title"><i class="fas fa-print"></i> PDFs de Bipagem (Hoje)</h4>
        <div class="table-responsive">
            <table class="table" id="tabela-bipagem-pdfs" style="width: 100%">
                <thead>
                    <tr>
                        <th>Arquivo</th>
                        <th>Horário</th>
                        <th>Tamanho</th>
                        <th style="width: 60px; text-align: center;">Ação</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="dashboard-panel mt-4">
    <h4 class="panel-title mb-1" style="border: none; padding: 0;"><i class="fas fa-history"></i> Histórico de
        Expedições Encerradas</h4>
    <p class="description-text mb-3">Dias finalizados disponíveis para geração de planilhas de conferência
        logística.</p>
    <div id="historico-container" style="display: flex; flex-wrap:wrap; gap: 15px;">
        <!-- O JS preenche isso com stat-cards de histórico -->
    </div>
</div>

<!-- Modal de Progresso do Envio em Lote -->
<div id="loteProgressOverlay" class="modal-overlay"></div>
<div id="loteProgressModal" class="custom-modal" style="max-width: 550px;" role="dialog" aria-modal="true"
    aria-labelledby="loteProgressTitle">
    <div class="custom-modal-header">
        <h3 id="loteProgressTitle" class="custom-modal-title-text">
            <i class="fas fa-cloud-upload-alt text-warning"
                style="color: var(--accent-orange, #ff9800); margin-right: 8px;"></i> Envio em Lote — Progresso
        </h3>
        <button id="loteProgressCloseBtn" class="custom-modal-close-btn" aria-label="Fechar">&times;</button>
    </div>

    <div class="custom-modal-body">
        <div id="lote-status-text" class="mb-3" style="font-size:0.95rem; color:var(--text-secondary,#aaa);">
            Iniciando processamento...
        </div>

        <!-- Barra de Progresso -->
        <div
            style="background:rgba(255,255,255,0.05); border-radius:10px; overflow:hidden; height:24px; margin-bottom:1rem; border:1px solid rgba(255,255,255,0.08);">
            <div id="lote-progress-bar"
                style="height:100%; width:0%; background:linear-gradient(90deg,#ff9800,#ff5722); transition:width 0.4s ease; border-radius:10px; display:flex; align-items:center; justify-content:center;">
                <span id="lote-progress-pct"
                    style="font-size:0.75rem; font-weight:bold; color:#fff; text-shadow:0 1px 2px rgba(0,0,0,0.5);">0%</span>
            </div>
        </div>

        <!-- Grid de Indicadores -->
        <div style="display:flex; gap:1rem; margin-bottom:1rem;">
            <div
                style="flex:1; background:rgba(76,175,80,0.08); border:1px solid rgba(76,175,80,0.2); border-radius:8px; padding:0.6rem; text-align:center;">
                <div id="lote-sucessos" style="font-size:1.4rem; font-weight:bold; color:#4CAF50;">0</div>
                <div style="font-size:0.75rem; color:#aaa;">Sucessos</div>
            </div>
            <div
                style="flex:1; background:rgba(244,67,54,0.08); border:1px solid rgba(244,67,54,0.2); border-radius:8px; padding:0.6rem; text-align:center;">
                <div id="lote-erros" style="font-size:1.4rem; font-weight:bold; color:#f44336;">0</div>
                <div style="font-size:0.75rem; color:#aaa;">Erros</div>
            </div>
            <div
                style="flex:1; background:rgba(255,152,0,0.08); border:1px solid rgba(255,152,0,0.2); border-radius:8px; padding:0.6rem; text-align:center;">
                <div id="lote-bloco" style="font-size:1.4rem; font-weight:bold; color:#ff9800;">-</div>
                <div style="font-size:0.75rem; color:#aaa;">Bloco</div>
            </div>
        </div>

        <!-- Detalhamento de Erros -->
        <div id="lote-log-container"
            style="display:none; max-height:180px; overflow-y:auto; background:rgba(0,0,0,0.3); border-radius:8px; padding:0.6rem; margin-bottom:1rem; font-size:0.8rem; font-family:monospace;">
            <div style="color:#f44336; font-weight:bold; margin-bottom:4px;">Erros encontrados:</div>
            <div id="lote-log-erros"></div>
        </div>
    </div>

    <div class="custom-modal-footer">
        <button id="btn-lote-fechar" class="btn btn-accent">Fechar</button>
    </div>
</div>
</div>

{{!-- MODAL LIGHTBOX FOTOS --}}
<div id="lightbox-foto" class="modal-lightbox"
    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(5px); z-index: 1060; justify-content: center; align-items: center; flex-direction: column;">
    <div class="lightbox-header"
        style="position: absolute; top: 0; left: 0; width: 100%; padding: 20px; display: flex; justify-content: space-between; align-items: center; background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent); color: white;">
        <div style="display: flex; flex-direction: column;">
            <span id="lightbox-nfe" style="font-size: 1.2rem; font-weight: bold; color: var(--accent-orange);">NF
                ---</span>
            <span id="lightbox-tipo" style="font-size: 1rem; color: #ccc;">Etiqueta</span>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            <button id="btn-rotacionar-lightbox"
                style="background: transparent; border: none; color: white; font-size: 1.4rem; cursor: pointer; padding: 10px;" title="Rotacionar Imagem"><i
                    class="fas fa-redo"></i></button>
            <button id="btn-fechar-lightbox"
                style="background: transparent; border: none; color: white; font-size: 1.5rem; cursor: pointer; padding: 10px;"><i
                    class="fas fa-times"></i></button>
        </div>
    </div>

    <div class="lightbox-content"
        style="position: relative; width: 90%; height: 80%; display: flex; justify-content: center; align-items: center;">
        <button class="lightbox-nav btn-prev"
            style="position: absolute; left: 0; background: rgba(255,255,255,0.1); border: none; color: white; padding: 20px; font-size: 2rem; cursor: pointer; border-radius: 8px; transition: 0.2s;"><i
                class="fas fa-chevron-left"></i></button>
        <img id="lightbox-img" src=""
            style="max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <button class="lightbox-nav btn-next"
            style="position: absolute; right: 0; background: rgba(255,255,255,0.1); border: none; color: white; padding: 20px; font-size: 2rem; cursor: pointer; border-radius: 8px; transition: 0.2s;"><i
                class="fas fa-chevron-right"></i></button>
    </div>

    <div class="lightbox-indicators" style="position: absolute; bottom: 20px; display: flex; gap: 10px;">
        <span class="indicator idx-0 active"
            style="width: 12px; height: 12px; border-radius: 50%; background: var(--accent-orange); transition: 0.3s; cursor: pointer;"></span>
        <span class="indicator idx-1"
            style="width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.3); transition: 0.3s; cursor: pointer;"></span>
    </div>
</div>

{{#section "scripts"}}
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap4.min.js"></script>
<script src="/public/scripts/toastSystem.js"></script>
<script src="/public/scripts/expedicaoDashboardManager.js"></script>
{{/section}}
</body>