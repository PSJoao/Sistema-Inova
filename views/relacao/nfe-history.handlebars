{{!< main}}

{{#section "head"}}
    <link href="/public/styles/estoque.css" rel="stylesheet">
    <style>
        .nfe-status {
            padding: 0.25rem 0.75rem;
            border-radius: var(--border-radius-md);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            display: inline-block;
        }
        .nfe-status.status-relacionada { background-color: var(--color-success, #28a745); }
        .nfe-status.status-pendente { background-color: var(--accent-orange, #fd7e14); }
        .nfe-status.status-cancelada { background-color: #dc3545; }
        .nfe-status.status-justificada_adiada { background-color: #007bff; }
        .nfe-status.status-alerta { background-color: #ffc107; color: #212529; }
    </style>
{{/section}}

<div class="content-card">
    {{!-- Cabeçalho da Página --}}
    <div class="page-header-actions">
        <h1 class="page-title">{{title}}</h1>
        
        {{!-- Painel Normal de Ações --}}
        <div id="normal-actions" style="display: flex; justify-content: end; gap: 10px; flex-wrap: wrap;">
            <button id="nfe-history-justify-report-btn" class="btn btn-outline-accent">
                <i class="fas fa-file-excel me-2"></i>Gerar Relatório
            </button>
            <button id="nfe-history-separation-report-btn" class="btn btn-outline-accent" title="Gerar relatório para separação de produtos">
                <i class="fas fa-file-pdf me-2"></i>Relatório Separação
            </button>
            <button id="nfe-history-report-btn" class="btn btn-outline-accent">
                <i class="fas fa-file-excel me-2"></i>Relatório "Sem Produtos"
            </button>
            <button id="nfe-history-products-carrier-btn" class="btn btn-outline-accent" title="Baixar produtos pendentes separado por transportadora">
                <i class="fas fa-boxes me-2"></i>Prod. por Transp.
            </button>
        </div>

        {{!-- Painel de Seleção Manual --}}
        <div id="selection-actions" style="display: none; justify-content: end; gap: 10px; flex-wrap: wrap;">
            <button id="nfe-generate-selected-btn" class="btn btn-accent">
                <i class="fas fa-file-pdf me-2"></i>Gerar Relatório de Selecionadas (<span id="selected-count">0</span>)
            </button>
            <button id="nfe-cancel-selection-btn" class="btn btn-outline-danger">
                Cancelar Seleção
            </button>
        </div>
    </div>

    {{!-- Barra de Filtros --}}
    <div class="estoque-filters-bar">
        <div class="estoque-filter-group" style="flex-grow: 1; min-width: 250px;">
            <label for="nfe-history-search-input">Busca Rápida</label>
            <input type="text" id="nfe-history-search-input" class="form-control" placeholder="Buscar por NFE, transportadora...">
        </div>
        <div class="estoque-filter-group">
            <label for="nfe-history-data-inicial">Data Inicial</label>
            <input type="date" id="nfe-history-data-inicial" class="form-control">
        </div>
        <div class="estoque-filter-group">
            <label for="nfe-history-data-final">Data Final</label>
            <input type="date" id="nfe-history-data-final" class="form-control">
        </div>
        <div class="estoque-filter-group">
            <label for="nfe-history-situacao-filter">Situação</label>
            <select id="nfe-history-situacao-filter" class="form-control" style="min-width: 140px;">
                <option value="">Todas</option>
                <option value="Relacionada">Relacionadas</option>
                <option value="Alerta">Alerta</option>
                <option value="Pendente">Pendentes</option>
                <option value="Cancelada">Canceladas</option>
            </select>
        </div>
        <div class="estoque-filter-group">
            <label for="nfe-history-justificativa-filter">Justificativa</label>
            <select id="nfe-history-justificativa-filter" class="form-control" style="min-width: 180px;">
                <option value="">Todas</option>
                <option value="SEM_JUSTIFICATIVA">Sem Justificativa</option>
                {{#each justificativas}}
                    <option value="{{this}}">{{this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="estoque-filter-group">
            <label for="nfe-history-carrier-filter">Transportadora</label>
            <select id="nfe-history-carrier-filter" class="form-control" style="min-width: 180px;">
                <option value="">Todas</option>
                {{#each transportadoras}}
                    <option value="{{this}}">{{this}}</option>
                {{/each}}
            </select>
        </div>
        <div class="estoque-filter-group">
            <label for="nfe-history-limite-filter">Mostrar</label>
            <select id="nfe-history-limite-filter" class="form-control" style="min-width: 80px;">
                <option value="20">20</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </div>
    </div>

    {{!-- Container da Tabela --}}
    <div class="table-responsive mt-3">
        <table class="table" id="tabela-estoque" style="width: 100%; white-space: normal; table-layout: auto;">
            <thead>
                <tr>
                    <th class="checkbox-col" style="display: none; width: 40px; text-align: center; vertical-align: middle;">
                        <input type="checkbox" id="nfe-select-all">
                    </th>
                    <th class="sortable" data-column="nfe_numero" style="cursor: pointer; user-select: none;">Nº da NF-e</th>
                    <th class="sortable" data-column="data_emissao" style="cursor: pointer; user-select: none;">Data Emissão</th>
                    <th class="sortable" data-column="status_para_relacao" style="cursor: pointer; user-select: none;">Situação</th>
                    <th class="sortable" data-column="transportadora_apelido" style="cursor: pointer; user-select: none;">Transportadora</th>
                    <th class="sortable" data-column="product_descriptions_list" style="cursor: pointer; user-select: none;">Lista de Produtos</th>
                    <th class="sortable" data-column="justificativa" style="cursor: pointer; user-select: none;">Última Justificativa</th>
                    <th class="sortable" data-column="data_acao" style="cursor: pointer; user-select: none;">Data da Ação</th>
                    <th>Nova Ação</th>
                </tr>
            </thead>
            <tbody id="table-body">
                {{!-- Renderização dinâmica via JS --}}
            </tbody>
        </table>
    </div>

    {{!-- Paginação --}}
    <div id="pagination-container" class="estoque-pagination"></div>

    {{!-- Estado vazio --}}
    <div id="empty-state" class="estoque-empty-state" style="display: none;">
        <i class="fas fa-file-invoice"></i>
        <p>Nenhuma nota fiscal encontrada.</p>
    </div>

    <div id="nfe-history-missing-products-container" class="nfe-history-missing-products" style="display: none;">
        <h3 class="section-title">Estruturas Faltantes (Contador)</h3>
        <ul id="nfe-history-missing-products-list" class="missing-products-list"></ul>
    </div>
</div>

{{#section "scripts"}}
    <script src="/public/scripts/nfeHistoryManager.js"></script>
{{/section}}