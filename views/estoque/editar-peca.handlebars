{{!--
views/estoque/editar-peca.handlebars
Formulário de edição de peça existente no estoque.
Quantidade é somente leitura (movimentação via bipagem futura).
--}}
<link rel="stylesheet" href="/public/styles/estoque.css">

<div class="content-card">
    <div class="page-header-actions">
        <h1 class="page-title">{{title}}</h1>
    </div>

    <form id="form-nova-peca" novalidate>

        {{!-- Seção: Identificação da Peça --}}
        <div class="estoque-form-section">
            <h5 class="form-section-title">Identificação da Peça</h5>
            <div class="estoque-form-row cols-3">
                <div class="form-group">
                    <label for="sku" class="form-label">SKU <span class="text-danger">*</span></label>
                    <input type="text" id="sku" name="sku" class="form-control" value="{{peca.sku}}" required>
                    <span class="validation-message" id="sku-validation"></span>
                </div>
                <div class="form-group">
                    <label for="numero_peca" class="form-label">Número da Peça</label>
                    <input type="text" id="numero_peca" name="numero_peca" class="form-control"
                        value="{{peca.numero_peca}}">
                    <span class="validation-message" id="numero-peca-validation"></span>
                </div>
                <div class="form-group">
                    <label for="fabrica_id" class="form-label">Fábrica <span class="text-danger">*</span></label>
                    <div class="input-group" style="display: flex; flex-direction: row;">
                        <select id="fabrica_id" name="fabrica_id" class="form-control" style="max-width: 400px;"
                            required>
                            <option value="">Carregando...</option>
                        </select>
                        <button class="btn btn-outline-secondary" type="button" id="btn-add-fabrica"
                            title="Adicionar Nova Fábrica">
                            <i class="fas fa-plus"></i> Nova Fábrica
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {{!-- Seção: Produto e Descrição --}}
        <div class="estoque-form-section">
            <h5 class="form-section-title">Produto e Descrição</h5>
            <div class="estoque-form-row cols-2">
                <div class="form-group">
                    <label for="produto_pai_input" class="form-label">Produto Pai <span
                            class="text-danger">*</span></label>
                    <div class="autocomplete-wrapper">
                        <input type="text" id="produto_pai_input" class="form-control"
                            placeholder="Digite o SKU ou nome do produto..." autocomplete="off">
                        <div class="autocomplete-panel" id="produto-pai-panel"></div>
                    </div>
                    <input type="hidden" id="produto_pai_sku" name="produto_pai_sku" value="{{peca.produto_pai_sku}}">
                    <input type="hidden" id="produto_pai_nome" name="produto_pai_nome"
                        value="{{peca.produto_pai_nome}}">
                    <div class="produto-pai-selected {{#if peca.produto_pai_sku}}visible{{/if}}"
                        id="produto-pai-selected">
                        <span class="pp-sku" id="pp-sku-display">{{peca.produto_pai_sku}}</span>
                        <span class="pp-nome" id="pp-nome-display">{{peca.produto_pai_nome}}</span>
                        <button type="button" class="btn-clear-pp" id="btn-clear-pp"
                            title="Remover seleção">&times;</button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="nome_peca" class="form-label">Nome da Peça <span class="text-danger">*</span></label>
                    <div class="autocomplete-wrapper">
                        <input type="text" id="nome_peca" name="nome_peca" class="form-control"
                            value="{{peca.nome_peca}}" autocomplete="off" required>
                        <div class="autocomplete-panel" id="nome-peca-panel"></div>
                    </div>
                </div>
            </div>
            <div class="estoque-form-row cols-2">
                <div class="form-group">
                    <label for="cor" class="form-label">Cor</label>
                    <input type="text" id="cor" name="cor" class="form-control" value="{{peca.cor}}">
                </div>
                <div class="form-group">
                    <label for="observacao" class="form-label">Observação</label>
                    <textarea id="observacao" name="observacao" class="form-control"
                        rows="2">{{peca.observacao}}</textarea>
                </div>
            </div>
        </div>

        {{!-- Seção: Medidas e Quantidade --}}
        <div class="estoque-form-section">
            <h5 class="form-section-title">Medidas e Quantidade</h5>
            <div class="estoque-form-row">
                <div class="form-group" style="grid-column: span 3;">
                    <label class="form-label">Medidas (mm) <span class="text-danger">*</span></label>
                    <div class="medidas-group">
                        <div class="form-group">
                            <label for="altura" class="form-label"
                                style="font-size: 0.8rem; color: var(--text-muted);">Altura (Largura)</label>
                            <input type="number" id="altura" name="altura" class="form-control" value="{{peca.altura}}"
                                min="0.01" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label for="largura" class="form-label"
                                style="font-size: 0.8rem; color: var(--text-muted);">Largura (Comprimento)</label>
                            <input type="number" id="largura" name="largura" class="form-control"
                                value="{{peca.largura}}" min="0.01" step="0.01" required>
                        </div>
                        <div class="form-group">
                            <label for="profundidade" class="form-label"
                                style="font-size: 0.8rem; color: var(--text-muted);">Profundidade (Espessura)</label>
                            <input type="number" id="profundidade" name="profundidade" class="form-control"
                                value="{{peca.profundidade}}" min="0.01" step="0.01" required>
                        </div>
                    </div>
                </div>
            </div>
            <div class="estoque-form-row" style="max-width: 250px;">
                <div class="form-group">
                    <label for="quantidade" class="form-label">Quantidade <span class="text-danger">*</span></label>
                    <input type="number" id="quantidade" name="quantidade" class="form-control"
                        value="{{peca.quantidade}}" min="0" step="1" required>
                </div>
            </div>
        </div>

        {{!-- Seção: Localização --}}
        <div class="estoque-form-section">
            <h5 class="form-section-title">Localização</h5>
            <div class="estoque-form-row cols-2" style="max-width: 400px;">
                <div class="form-group">
                    <label for="coluna_localizacao" class="form-label">Coluna</label>
                    <input type="text" id="coluna_localizacao" name="coluna_localizacao" class="form-control"
                        value="{{peca.coluna_localizacao}}">
                </div>
                <div class="form-group">
                    <label for="linha_localizacao" class="form-label">Linha</label>
                    <input type="text" id="linha_localizacao" name="linha_localizacao" class="form-control"
                        value="{{peca.linha_localizacao}}">
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4" style="display: flex; justify-content: flex-end; gap: 10px;">
            <a href="/estoque" class="btn btn-light me-2">Cancelar</a>
            <button type="submit" class="btn btn-accent" id="btn-salvar-peca">
                <i class="fas fa-save"></i> Atualizar Peça
            </button>
        </div>
    </form>
</div>

{{#section "scripts"}}
<script>
    // Flag para o JS saber que está em modo de edição
    window.ESTOQUE_MODE = 'edit';
    window.ESTOQUE_PECA_ID = {{ peca.id }};
    window.ESTOQUE_FABRICA_ID = {{ peca.fabrica_id }};
</script>
<script src="/public/scripts/estoquePecaFormManager.js"></script>
{{/section}}