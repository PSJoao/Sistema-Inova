<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - InovaXPress</title>
  <link rel="shortcut icon" href="/public/images/inovaxpress_logo.png" type="image/png">

  <link href="/public/styles/reset.css" rel="stylesheet">
  <link href="/public/styles/theme.css" rel="stylesheet">
  <link href="/public/styles/components.css" rel="stylesheet"> {{!-- Para os botões .btn --}}
  <link href="/public/styles/main-menu.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

<body class="main-menu-page">

  <header class="main-menu-header">
    <div class="main-menu-title-brand">
      <img src="/public/images/inovaxpress_logo_completa.png" alt="InovaXPress Logo"
        style="max-height: 100px; width: auto; display: block; margin: 0 auto;">
    </div>
  </header>

  <div class="menu-grid-container">
    {{!-- Monitoramento de Marketplaces --}}
    {{#if permit_monitoramento}}
    <div class="module-card module-medium">
      <div class="module-header">
        <i class="fas fa-chart-line module-icon"></i>
        <h2>Monitoramento de Marketplaces</h2>
      </div>
      <div class="module-buttons">
        {{#if permit_monitoramento_madeira_lucas}}
        <a href="/madeira/urls" class="btn btn-accent btn-card"><i class="fas fa-store"></i> Madeira - Lucas</a>
        {{/if}}
        {{#if permit_monitoramento_madeira_eliane}}
        <a href="/madeiramadeira/urls" class="btn btn-accent btn-card"><i class="fas fa-store"></i> Madeira - Eliane</a>
        {{/if}}
        {{#if permit_monitoramento_viavarejo}}
        <a href="/viavarejo/urls" class="btn btn-accent btn-card"><i class="fas fa-shopping-bag"></i> ViaVarejo</a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Notas Fiscais e Faturamento --}}
    {{#if permit_faturamento}}
    <div class="module-card module-large">
      <div class="module-header">
        <i class="fas fa-file-invoice module-icon"></i>
        <h2>Notas Fiscais e Faturamento</h2>
      </div>
      <div class="module-buttons">
        {{#if permit_faturamento_gerenciar_emissoes}}
        <a href="/emissao" class="btn btn-accent btn-card"><i class="fas fa-barcode"></i> Gerenciar Emissões</a>
        {{/if}}
        {{#if permit_faturamento_gerar_etiquetas}}
        <a href="/emissao/nfe-management" class="btn btn-accent btn-card"><i class="fas fa-sticky-note"></i> Gerar
          Etiquetas NFe</a>
        {{/if}}
        {{#if permit_faturamento_automatico}}
        <a href="/faturamento-automatico" class="btn btn-accent btn-card"><i class="fas fa-chart-line"></i> Faturador
          Automático</a>
        {{/if}}
        {{#if permit_faturamento_gerenciar_pedidos}}
        <a href="/acompanhamento/pedidos" class="btn btn-accent btn-card"><i class="fas fa-shopping-cart"></i> Gerenciar
          Pedidos</a>
        {{/if}}
        {{#if permit_faturamento_assistencias}}
        <a href="/assistencias" class="btn btn-accent btn-card"><i class="fas fa-file-invoice"></i> Assistências</a>
        {{/if}}
        {{#if permit_faturamento_historico_notas}}
        <a href="/historico-nfe" class="btn btn-accent btn-card"><i class="fas fa-history"></i> Histórico de Notas</a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Produtos --}}
    {{#if permit_produtos}}
    <div class="module-card module-medium">
      <div class="module-header">
        <i class="fas fa-cogs module-icon"></i>
        <h2>Produtos</h2>
      </div>
      <div class="module-buttons">
        {{#if permit_produtos_gerenciar}}
        <a href="/produtos/listagem" class="btn btn-accent btn-card"><i class="fas fa-box"></i> Gerenciar Produtos</a>
        {{/if}}
        {{#if permit_produtos_anuncios}}
        <a href="/anuncios" class="btn btn-accent btn-card"><i class="fas fa-bullhorn"></i> Gerenciar Anúncios</a>
        {{/if}}
        {{#if permit_produtos_tipos}}
        <a href="/tipos" class="btn btn-accent btn-card"><i class="fas fa-file-export"></i> Gerenciar Tipos</a>
        {{/if}}
        {{#if permit_produtos_sincronizar}}
        <a href="/product-sync" class="btn btn-accent btn-card"><i class="fas fa-sync"></i> Sincronizar Produtos</a>
        {{/if}}
        {{#if permit_produtos_estoque_dev}}
        <a href="/estoque" class="btn btn-accent btn-card"><i class="fas fa-cogs"></i> Estoque Dev.</a>
        {{/if}}
        {{#if permit_produtos_bipagem_pecas}}
        <a href="/estoque/bipagem" class="btn btn-accent btn-card"><i class="fas fa-barcode"></i> Bipagem de Peças</a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Expedição e Etiquetas --}}
    {{#if permit_expedicao}}
    <div class="module-card module-large">
      <div class="module-header">
        <i class="fas fa-tags module-icon"></i>
        <h2>Expedição e Etiquetas</h2>
      </div>
      <div class="module-buttons">
        {{#if permit_expedicao_ordenador}}
        <a id="etiquetas-btn" href="/etiquetas" class="btn btn-accent btn-card"><i class="fas fa-tag"></i> Ordenador de
          Etiquetas</a>
        {{/if}}
        {{#if permit_expedicao_gondolas}}
        <a href="/etiquetas/gondola" class="btn btn-accent btn-card"><i class="fas fa-border-all"></i> Gerenciar
          Gôndolas</a>
        {{/if}}
        {{#if permit_expedicao_rel_tarde}}
        <a href="/etiquetas/relatorio-tarde" class="btn btn-accent btn-card"><i class="far fa-file-alt"></i> Gerenciar
          Rel. Tarde</a>
        {{/if}}
        {{#if permit_expedicao_bipagem_produtos}}
        <a href="/etiquetas/bipagem" class="btn btn-accent btn-card"><i class="fas fa-barcode"></i> Bipagem de
          Produtos</a>
        {{/if}}
        {{#if permit_expedicao_dashboard}}
        <a href="/etiquetas/dashboard-expedicao" class="btn btn-accent btn-card"><i class="fas fa-chart-pie"></i> Painel
          de Expedição</a>
        {{/if}}
        {{#if permit_expedicao_bipagem_exp}}
        <a href="/etiquetas/expedicao/bipagem" class="btn btn-accent btn-card"><i class="fas fa-qrcode"></i> Expedição
          Bip.</a>
        {{/if}}
        {{#if permit_expedicao_massa}}
        <a href="/etiquetas/bipagem-massa" class="btn btn-accent btn-card"><i class="fas fa-layer-group"></i> Alteração
          em Massa</a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Conferência --}}
    {{#if permit_conferencia}}
    <div class="module-card module-small">
      <div class="module-header">
        <i class="fas fa-check-circle module-icon"></i>
        <h2>Conferência</h2>
      </div>
      <div class="module-buttons">
        {{#if permit_conferencia_bipagem}}
        <a href="/conferencia/bipagem" class="btn btn-accent btn-card"><i class="fas fa-boxes"></i> Conferência de
          Pedidos</a>
        {{/if}}
        {{#if permit_conferencia_codigos}}
        <a href="/conferencia/gerenciamento-codigos" class="btn btn-accent btn-card"><i class="fas fa-cog"></i>
          Gerenciar Códigos</a>
        {{/if}}
        {{#if permit_conferencia_ml_batch}}
        <a href="/conferencia/ml-batch" class="btn btn-accent btn-card"><i class="fas fas fa-align-left"></i> Conf. para
          Faturamento</a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Transporte e Logística --}}
    {{#if permit_logistica}}
    <div class="module-card module-small">
      <div class="module-header">
        <i class="fas fa-truck module-icon"></i>
        <h2>Transporte e Logística</h2>
      </div>
      <div class="module-buttons">
        {{#if permit_logistica_relacoes}}
        <a href="/relacoes" class="btn btn-accent btn-card"><i class="fas fa-truck"></i> Gerenciar Relações</a>
        {{/if}}
        {{#if permit_logistica_rastreio}}
        <a href="/rastreio" class="btn btn-accent btn-card"><i class="fas fa-paper-plane"></i> Acompanhamentos</a>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Painel Administrativo (Exclusivo para Administradores) --}}
    {{#if isAdmin}}
    <div class="module-card module-small">
      <div class="module-header">
        <i class="fas fa-users-cog module-icon"></i>
        <h2>Administração</h2>
      </div>
      <div class="module-buttons">
        <a href="/admin/usuarios" class="btn btn-accent btn-card"><i class="fas fa-users"></i> Gerenciar Usuários</a>
      </div>
    </div>
    {{/if}}
  </div>

  {{!-- Botão de Sair --}}
  <div class="menu-footer">
    <a href="/logout" class="btn btn-danger btn-logout">
      <i class="fas fa-sign-out-alt"></i> Sair
    </a>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const etiquetasBtn = document.getElementById('etiquetas-btn');
      if (etiquetasBtn) {
        const isMobile = window.innerWidth <= 768;
        etiquetasBtn.href = isMobile ? '/etiquetas/bipagem' : '/etiquetas';
        console.log(isMobile);
        console.log(etiquetasBtn.href);
      }
    });
  </script>

</body>

</html>